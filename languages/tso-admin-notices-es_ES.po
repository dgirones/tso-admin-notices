msgid "TSO Admin Notices Manager"
msgstr "TSO Gestor de Avisos"

msgid "Hides annoying plugin notices (promotional, backup, update messages) from the WordPress admin. Notices remain recoverable via the admin bar."
msgstr "Oculta los avisos molestos de los plugins (promocionales, copias de seguridad, actualizaciones) del administrador de WordPress. Los avisos se pueden recuperar desde la barra de administración."

msgid "Plugin Notices"
msgstr "Avisos de Plugins"

msgid "Hides annoying plugin notices (promotional, backup, update messages, etc.) from the WordPress admin area. Notices are still generated but remain hidden; you can temporarily reveal them using the admin bar button."
msgstr "Oculta los avisos molestos de los plugins (promocionales, copias de seguridad, actualizaciones, etc.) del panel de administración de WordPress. Los avisos siguen generándose pero permanecen ocultos; puedes mostrarlos temporalmente usando el botón de la barra de administración."

msgid "Notices: ..."
msgstr "Avisos: ..."

msgid "Show/hide plugin notices"
msgstr "Mostrar/ocultar avisos de plugins"

msgid "Show/hide plugin notices on this screen"
msgstr "Mostrar/ocultar avisos de plugins en esta pantalla"

msgid "General settings"
msgstr "Configuración general"

msgid "Enable filtering"
msgstr "Activar el filtrado"

msgid "Enable plugin notice filtering"
msgstr "Activar el filtrado de avisos de plugins"

msgid "Admin bar"
msgstr "Barra de administración"

msgid "Show counter and toggle button in the admin bar"
msgstr "Mostrar el contador y el botón de alternancia en la barra de administración"

msgid "Plugin whitelist"
msgstr "Lista blanca de plugins"

msgid "Check the plugins whose notices you want to keep visible. Notices from checked plugins will not be hidden."
msgstr "Marca los plugins cuyos avisos quieres seguir viendo. Los avisos de los plugins marcados no se ocultarán."

msgid "No installed plugins found."
msgstr "No se han encontrado plugins instalados."

msgid "Filter plugins..."
msgstr "Filtrar plugins..."

msgid "Save changes"
msgstr "Guardar cambios"

msgid "Hidden notices"
msgstr "Avisos ocultos"

msgid "Hidden notices on this screen"
msgstr "Avisos ocultos en esta pantalla"

msgid "Show notices"
msgstr "Mostrar avisos"

msgid "Show notices on this screen"
msgstr "Mostrar avisos en esta pantalla"

msgid "Hide notices"
msgstr "Ocultar avisos"

msgid "Hide notices on this screen"
msgstr "Ocultar avisos en esta pantalla"

msgid "No notices hidden"
msgstr "Ningún aviso oculto"

msgid "No notices hidden on this screen"
msgstr "Ningún aviso oculto en esta pantalla"
