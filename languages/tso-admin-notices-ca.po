msgid "TSO Admin Notices Manager"
msgstr "TSO Gestor d'Avisos"

msgid "Hides annoying plugin notices (promotional, backup, update messages) from the WordPress admin. Notices remain recoverable via the admin bar."
msgstr "Amaga els avisos molestos dels plugins (promocionals, còpies de seguretat, actualitzacions) de l'administrador de WordPress. Els avisos es poden recuperar des de la barra d'administració."

msgid "Plugin Notices"
msgstr "Avisos de Plugins"

msgid "Hides annoying plugin notices (promotional, backup, update messages, etc.) from the WordPress admin area. Notices are still generated but remain hidden; you can temporarily reveal them using the admin bar button."
msgstr "Amaga els avisos molestos dels plugins (promocionals, còpies de seguretat, actualitzacions, etc.) del tauler d'administració de WordPress. Els avisos es continuen generant però romanen ocults; pots mostrar-los temporalment des del botó de la barra d'administració."

msgid "Notices: ..."
msgstr "Avisos: ..."

msgid "Show/hide plugin notices"
msgstr "Mostrar/amagar avisos de plugins"

msgid "Show/hide plugin notices on this screen"
msgstr "Mostrar/amagar avisos de plugins en aquesta pantalla"

msgid "General settings"
msgstr "Configuració general"

msgid "Enable filtering"
msgstr "Activar el filtrat"

msgid "Enable plugin notice filtering"
msgstr "Activar el filtrat d'avisos de plugins"

msgid "Admin bar"
msgstr "Barra d'administració"

msgid "Show counter and toggle button in the admin bar"
msgstr "Mostrar el comptador i el botó d'alternança a la barra d'administració"

msgid "Plugin whitelist"
msgstr "Llista blanca de plugins"

msgid "Check the plugins whose notices you want to keep visible. Notices from checked plugins will not be hidden."
msgstr "Marca els plugins dels quals vols continuar veient els avisos. Els avisos dels plugins marcats no s'ocultaran."

msgid "No installed plugins found."
msgstr "No s'han trobat plugins instal·lats."

msgid "Filter plugins..."
msgstr "Filtrar plugins..."

msgid "Save changes"
msgstr "Desar canvis"

msgid "Hidden notices"
msgstr "Avisos ocults"

msgid "Hidden notices on this screen"
msgstr "Avisos ocults en aquesta pantalla"

msgid "Show notices"
msgstr "Mostra els avisos"

msgid "Show notices on this screen"
msgstr "Mostra els avisos d'aquesta pantalla"

msgid "Hide notices"
msgstr "Amaga els avisos"

msgid "Hide notices on this screen"
msgstr "Amaga els avisos d'aquesta pantalla"

msgid "No notices hidden"
msgstr "Cap avís ocult"

msgid "No notices hidden on this screen"
msgstr "Cap avís ocult en aquesta pantalla"
